.package/
.sign/
.tizen-rds/
.rds_delta
.sdk_delta.info
.tizen-ui-builder-tool.xml
*.wgt
*.tpk
*.apk
author-signature.xml
signature1.xml

# Node dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test & coverage artifacts
coverage/
.nyc_output/
test-results/
