# IDE & Editor local configurations
.idea/
*.iml
.vscode/
.settings/
.externalToolBuilders/
.project
.tproject
*.suo
*.user
*.userosscache
*.sln.docstates

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs, scratch files & temporary data
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
scratch/
.tmp_app_data/

# Environment configurations & local overrides
.env
.env.*
!.env.example

# Signing credentials, keys & certificates
*.p12
*.pfx
*.pem
*.key
*.jks
*.keystore
author.p12
distributor.p12
certificate.p12
certificates/
cert/
keys/
profiles.xml

# Local emulator and device artifacts
emulator/
sdb/
device/

# AI coding-agent & assistant local state
.gemini/
.antigravity/
