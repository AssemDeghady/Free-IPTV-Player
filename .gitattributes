# ============================================================
# Free IPTV Player — .gitattributes
# Normalized Line Endings & Binary Designations
# ============================================================

# Auto-detect text files and normalize line endings to LF
* text=auto

# Web application source files (LF)
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.m3u text eol=lf
*.m3u8 text eol=lf

# Windows scripts (CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Image & visual assets (Binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary

# Tizen packages (Binary)
*.wgt binary
*.tpk binary
*.apk binary

# Certificates & keystores (Binary)
*.p12 binary
*.pfx binary
*.jks binary
*.keystore binary

# Archives (Binary)
*.zip binary
*.7z binary
*.rar binary
*.tar binary
*.gz binary
